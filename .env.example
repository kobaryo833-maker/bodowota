# Bodowota server configuration.
# Copy to .env for local development. .env is gitignored — never commit a real token.

PORT=8787

# BoardGameGeek XML API. Application submitted 2026-09-02, pending review.
# Leave BGG_API_TOKEN empty until the token arrives: the whole access layer is
# developed and tested against recorded fixtures, so an empty token is not a blocker.
BGG_API_BASE_URL=https://boardgamegeek.com/xmlapi2
BGG_API_TOKEN=

# Promised in the API application. Do not raise these without re-reading the terms.
BGG_MAX_REQUESTS_PER_SECOND=1
BGG_CACHE_TTL_DAYS=7

# Sent so BGG can identify and contact us if our traffic misbehaves.
BGG_USER_AGENT=Bodowota/0.1 (personal board game collection manager; contact: TODO@example.com)
